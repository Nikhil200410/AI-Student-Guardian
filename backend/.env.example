# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to Git.

# Port the Express server listens on
PORT=5000

# PostgreSQL connection string
# If you sign up for a free hosted Postgres (Supabase or Neon), they will
# give you a connection string that looks like this:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Which frontend origin is allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# --- Supabase Auth ---
# From your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Set to "production" when deploying (makes auth cookies require HTTPS).
# Leave unset for local development.
NODE_ENV=development
