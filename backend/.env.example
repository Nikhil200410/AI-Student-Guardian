# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to Git.

# Port the Express server listens on
PORT=5000

# PostgreSQL connection string
# If you sign up for a free hosted Postgres (Supabase or Neon), they will
# give you a connection string that looks like this:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Which frontend origin is allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# --- Phase 1: Authentication ---

# Any long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret — anyone with it can forge login tokens.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# How long an OTP code stays valid, in minutes
OTP_EXPIRY_MINUTES=10

# Resend (resend.com) — free tier is enough for a student project.
# Sign up, verify a sending domain (or use their default onboarding@resend.dev
# for testing), then create an API key.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=AI Student Guardian <onboarding@resend.dev>

# Set to "production" when deploying (makes the auth cookie require HTTPS).
# Leave unset for local development.
NODE_ENV=development
